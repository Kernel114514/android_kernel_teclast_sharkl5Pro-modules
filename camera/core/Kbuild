ADAPT_DIR := $(BSP_BOARD_CAMERA_MODULE_ISP_ADAPT_VERSION)

ifeq ($(ISP_DIR),dcam_r6p0_isp_r6p91)
KO_MODULE_SRC += $(shell find $(KO_MODULE_PATH)/$(ISP_DIR) -name "*.c")
else
  ifeq ($(ISP_DIR),isp2.6)
# Keep the stock object order for sprd_camera.ko
KO_MODULE_SRC += \
	$(KO_MODULE_PATH)/$(ISP_DIR)/src/cam_trusty.c \
	$(KO_MODULE_PATH)/$(ISP_DIR)/src/isp_3dnr.c \
