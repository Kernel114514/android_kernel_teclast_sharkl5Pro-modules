#
# vdsp_sipc.ko
# vdsp_spipe.ko
# sprd_vdsp.ko
#
# Kbuild: for kernel building external module
#
# Note:
# - Please refer to modules/sample/Kbuild to find out what should be
#   done is this Kbuild file
#

VDSP_DIR := $(BSP_BOARD_CAMERA_MODULE_VDSP_DEVICE)

#
# Source List
#
KO_MODULE_NAME := sprd_vdsp
KO_MODULE_PATH := $(src)
KO_MODULE_SRC  :=

KO_MODULE_SRC += \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/vdsp_dvfs.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/vdsp_smem.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/pi_library_load.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/common.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xrp_firmware.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xrp_alloc.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/vdsp_log.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xrp_address_map.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xrp_library_loader.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/vdsp_ipi_drv.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xrp_cma_alloc.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/vdsp_hw.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xrp_faceid.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/xvp_main.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp/vdsp_trusty.c

#
# Final Objects
#
obj-m := $(KO_MODULE_NAME).o
# Comment it if the only object file has the same name with module
$(KO_MODULE_NAME)-y := $(patsubst $(src)/%.c,%.o,$(KO_MODULE_SRC))

#
# Source List
#
KO_MODULE_NAME := vdsp_sipc
KO_MODULE_PATH := $(src)
KO_MODULE_SRC  :=

KO_MODULE_SRC += \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/uipc/sipc/src/vdsp_smsg.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/uipc/sipc/src/vdsp_smem_interface.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/uipc/sipc/src/vdsp_sipc.c

#
# Final Objects
#
obj-m += $(KO_MODULE_NAME).o
# Comment it if the only object file has the same name with module
$(KO_MODULE_NAME)-y := $(patsubst $(src)/%.c,%.o,$(KO_MODULE_SRC))

#
# Source List
#
KO_MODULE_NAME := vdsp_spipe
KO_MODULE_PATH := $(src)
KO_MODULE_SRC  :=

KO_MODULE_SRC += \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/uipc/spipe/src/vdsp_spipe.c \
	$(KO_MODULE_PATH)/$(VDSP_DIR)/uipc/spipe/src/vdsp_sbuf.c

#
# Final Objects
#
obj-m += $(KO_MODULE_NAME).o
# Comment it if the only object file has the same name with module
$(KO_MODULE_NAME)-y := $(patsubst $(src)/%.c,%.o,$(KO_MODULE_SRC))

#
# Build Options
#
ccflags-y += -DDEBUG
ccflags-y += -DKERNEL_VERSION_414
ccflags-y += -Wno-error -Wno-format-extra-args
ccflags-y += -I$(KO_MODULE_PATH)/../interface
ccflags-y += -I$(srctree)/drivers/staging/android/ion
ccflags-y += -I$(srctree)/drivers/devfreq/apsys/
ccflags-y += -I$(srctree)/drivers/devfreq/apsys/vdsp
ccflags-y += -I$(KO_MODULE_PATH)/common
ccflags-y += -I$(KO_MODULE_PATH)/$(VDSP_DIR)/xrp
ccflags-y += -I$(KO_MODULE_PATH)/$(VDSP_DIR)/uipc/sipc/inc

ifeq ($(CONFIG_COMPAT),y)
ccflags-y += -DCONFIG_COMPAT
endif

ifeq ($(TEST_ON_HAPS),true)
ccflags-y += -DTEST_ON_HAPS
endif
