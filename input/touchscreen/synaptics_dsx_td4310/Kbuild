KO_MODULE_NAME := synaptics_dsx_td4310
KO_MODULE_PATH := $(src)
KO_MODULE_SRC  :=

KO_MODULE_SRC += \
	$(KO_MODULE_PATH)/synaptics_dsx_fw_update.c \
	$(KO_MODULE_PATH)/synaptics_dsx_test_reporting.c \
	$(KO_MODULE_PATH)/synaptics_dsx_i2c.c \
	$(KO_MODULE_PATH)/synaptics_dsx_rmi_dev.c

#
# Build Options
#
ccflags-y += -DDEBUG

#
# Final Objects
#
obj-m := $(KO_MODULE_NAME).o
# Comment it if the only object file has the same name with module
$(KO_MODULE_NAME)-y := $(patsubst $(src)/%.c,%.o,$(KO_MODULE_SRC))
