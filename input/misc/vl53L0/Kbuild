KO_MODULE_NAME := stmvl53l0
KO_MODULE_PATH := $(src)
KO_MODULE_SRC  :=

KO_MODULE_SRC += \
	$(KO_MODULE_PATH)/stmvl53l0_module-i2c.c \
	$(KO_MODULE_PATH)/stmvl53l0_module-cci.c \
	$(KO_MODULE_PATH)/stmvl53l0_module.c \
	$(KO_MODULE_PATH)/src/vl53l0_api_histogram.c \
	$(KO_MODULE_PATH)/src/vl53l0_api_core.c \
	$(KO_MODULE_PATH)/src/vl53l0_platform.c \
	$(KO_MODULE_PATH)/src/vl53l0_api_ranging.c \
	$(KO_MODULE_PATH)/src/vl53l0_api_calibration.c \
	$(KO_MODULE_PATH)/src/vl53l0_port_i2c.c \
	$(KO_MODULE_PATH)/src/vl53l0_api_strings.c \
	$(KO_MODULE_PATH)/src/vl53l0_i2c_platform.c \
	$(KO_MODULE_PATH)/src/vl53l0_api.c

#
# Build Options
#
ccflags-y += -DDEBUG
ccflags-y += -I$(KO_MODULE_PATH)/inc


#
# Final Objects
#
obj-m := $(KO_MODULE_NAME).o
# Comment it if the only object file has the same name with module
$(KO_MODULE_NAME)-y := $(patsubst $(src)/%.c,%.o,$(KO_MODULE_SRC))
